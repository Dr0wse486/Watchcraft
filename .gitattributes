# Normalise line endings in the repository, not in the working tree.
#
# Without this, a Windows clone checks gradlew out with CRLF and the wrapper
# stops being executable on Linux and macOS. Committing LF and letting each
# platform decide is the only setting that behaves the same everywhere.
* text=auto eol=lf

# The Gradle wrapper script must keep LF even if someone flips autocrlf.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Generated art and archives. Never touch these.
*.png binary
*.jar binary
*.zip binary

# Generated by tools/generate_drone_mesh.py. Text, but byte-comparable against
# the verifier, so no newline translation is allowed.
*.obj binary
*.mtl binary
